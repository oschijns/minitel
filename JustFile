
# ESP export script expect a Posix compliant shell
set shell := ["bash", "-uc"]


# Run the TCP Socket example
example-tcp:
    cargo run -p minitel-app-example --features tcp -- 0.0.0.0:3000


# Run the Axum WebSocket example
example-axum:
    cargo run -p minitel-app-example --features axum -- 0.0.0.0:3000


# Run the ESP32 example
example-esp32:
    source ~/export-esp.sh && cargo +esp --config minitel-app-example/cargo-config-esp.toml run -p minitel-app-example --features=esp -- --monitor

# Run the minitel WiFi app
check-wifi:
    source ~/export-esp.sh && cargo +esp --config minitel-wifi/cargo-config-esp.toml check -p minitel-wifi


# Run the minitel WiFi app
run-wifi:
    source ~/export-esp.sh && cargo +esp --config minitel-wifi/cargo-config-esp.toml run -p minitel-wifi -- --monitor


# Host a simple server for testing the minitel sample app
host-server:
    python3 -m http.server 8000 --bind 0.0.0.0
